+func TestMCPImageResultPreservesImagesAndMetadata(t *testing.T) {
+	const data = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aG1sAAAAASUVORK5CYII="
+	out := renderToolResult(&mcp.CallToolResult{
+		Content: []mcp.Content{
+			mcp.TextContent{Type: "text", Text: "generated"},
+			mcp.ImageContent{Type: "image", MIMEType: "image/png", Data: data},
+			mcp.TextContent{Type: "text", Text: "second image"},
+			mcp.ImageContent{Type: "image", MIMEType: "image/png", Data: data},
+		},
+		StructuredContent: map[string]any{"task_id": "saved-task", "status": "succeeded"},
+	})
+	const prefix = "__GBOT_TOOL_CONTENT__:"
+	if !strings.HasPrefix(out, prefix) {
+		t.Fatal("MCP images were reduced to plain text")
+	}
+	var env struct {
+		Text    string             `json:"text"`
+		Content []sdk.ContentBlock `json:"content"`
+	}
+	if err := json.Unmarshal([]byte(strings.TrimPrefix(out, prefix)), &env); err != nil {
+		t.Fatal(err)
+	}
+	if len(env.Content) != 5 {
+		t.Fatalf("got %d blocks, want text/image/text/image/metadata", len(env.Content))
+	}
+	for _, i := range []int{1, 3} {
+		block := env.Content[i]
+		if block.Type != "image_url" || block.ImageURL == nil || block.ImageURL.URL != "data:image/png;base64,"+data {
+			t.Fatal("image payload changed or missing")
+		}
+		if _, err := base64.StdEncoding.DecodeString(strings.TrimPrefix(block.ImageURL.URL, "data:image/png;base64,")); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if env.Content[0].Text != "generated" || env.Content[2].Text != "second image" || !strings.Contains(env.Content[4].Text, "saved-task") {
+		t.Fatal("text/metadata was lost")
+	}
+	if strings.Contains(env.Text, data) {
+		t.Fatal("image bytes leaked into text fallback")
+	}
+}
+
+func TestMCPImageResultKeepsErrorAndTextOnlyBehavior(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		result *mcp.CallToolResult
+		want   string
+	}{
+		{"empty", nil, "(empty mcp result)"},
+		{"text", &mcp.CallToolResult{Content: []mcp.Content{mcp.TextContent{Type: "text", Text: "hello"}}}, "hello"},
+		{"error", &mcp.CallToolResult{IsError: true, Content: []mcp.Content{mcp.TextContent{Type: "text", Text: "upstream rejected"}}}, "Error: MCP tool returned error\nupstream rejected"},
+		{"invalid image", &mcp.CallToolResult{Content: []mcp.Content{mcp.ImageContent{Type: "image", MIMEType: "image/png", Data: "!invalid!"}}}, "[Image content: image/png]"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := renderToolResult(tc.result); got != tc.want {
+				t.Fatalf("got %q, want %q", got, tc.want)
+			}
+		})
+	}
+	result := &mcp.CallToolResult{IsError: true, Content: []mcp.Content{mcp.ImageContent{Type: "image", MIMEType: "image/png", Data: "AQID"}}}
+	var env struct {
+		Content []sdk.ContentBlock `json:"content"`
+	}
+	if err := json.Unmarshal([]byte(strings.TrimPrefix(renderToolResult(result), "__GBOT_TOOL_CONTENT__:")), &env); err != nil {
+		t.Fatal(err)
+	}
+	if len(env.Content) != 2 || env.Content[0].Text != "Error: MCP tool returned error" {
+		t.Fatal("image response lost error marker")
+	}
+}
