+// This test uses the real image-gen-mcp binary with a local fake upstream.
+// It never loads user configuration or contacts a paid image service.
+func TestImageGenMCPTransports(t *testing.T) {
+	binary := os.Getenv("IMAGE_GEN_MCP_BINARY")
+	if binary == "" {
+		t.Skip("set IMAGE_GEN_MCP_BINARY to run image-gen-mcp integration")
+	}
+	im := image.NewRGBA(image.Rect(0, 0, 96, 96))
+	for y := 0; y < 96; y++ {
+		for x := 0; x < 96; x++ {
+			im.SetRGBA(x, y, color.RGBA{R: 255, A: 255})
+		}
+	}
+	var pngBytes bytes.Buffer
+	if err := png.Encode(&pngBytes, im); err != nil {
+		t.Fatal(err)
+	}
+	for _, mode := range []string{"stdio", "http"} {
+		t.Run(mode, func(t *testing.T) {
+			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path != "/v1/images/generations" || r.Header.Get("Authorization") != "Bearer fixture-key" {
+					t.Error("unexpected fixture request")
+				}
+				_ = json.NewEncoder(w).Encode(map[string]any{"data": []any{map[string]string{"b64_json": base64.StdEncoding.EncodeToString(pngBytes.Bytes())}}})
+			}))
+			defer upstream.Close()
+			dir := t.TempDir()
+			addr := "127.0.0.1:8080"
+			if mode == "http" {
+				ln, err := net.Listen("tcp", "127.0.0.1:0")
+				if err != nil {
+					t.Fatal(err)
+				}
+				addr = ln.Addr().String()
+				_ = ln.Close()
+			}
+			config := fmt.Sprintf("default_model: fixture\noutput_dir: %q\nwait_timeout: 3s\nhttp:\n  listen: %q\n  public_url: %q\n  token_env: ''\nmodels:\n  fixture:\n    provider: openai\n    base_url: %q\n    token: fixture-key\n    model: fixture-model\n    capabilities: [generate]\n    max_images: 1\n    max_input_images: 1\n", filepath.Join(dir, "data"), addr, "http://"+addr, upstream.URL+"/v1")
+			configPath := filepath.Join(dir, "config.yaml")
+			if err := os.WriteFile(configPath, []byte(config), 0600); err != nil {
+				t.Fatal(err)
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+			defer cancel()
+			no := false
+			cfg := ServerConfig{Type: &mode, ToolTimeout: 10, ExposeResources: &no, ExposePrompts: &no}
+			if mode == "stdio" {
+				cfg.Command = binary
+				cfg.Args = []string{"-config", configPath, "-transport", "stdio"}
+			} else {
+				cmd := exec.CommandContext(ctx, binary, "-config", configPath, "-transport", "http")
+				if err := cmd.Start(); err != nil {
+					t.Fatal(err)
+				}
+				defer func() { _ = cmd.Process.Kill(); _ = cmd.Wait() }()
+				for {
+					conn, err := net.DialTimeout("tcp", addr, 100*time.Millisecond)
+					if err == nil {
+						_ = conn.Close()
+						break
+					}
+					select {
+					case <-ctx.Done():
+						t.Fatal("HTTP server did not start")
+					case <-time.After(25 * time.Millisecond):
+					}
+				}
+				cfg.URL = "http://" + addr + "/mcp"
+			}
+			session, err := Connect(ctx, "image-gen", cfg)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer session.Close()
+			tools, err := session.Tools(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(tools) != 5 {
+				t.Fatalf("discovered %d tools, want 5", len(tools))
+			}
+			var generate sdk.Tool
+			for _, tool := range tools {
+				if tool.Name() == "mcp_image_gen_generate_image" {
+					generate = tool
+				}
+			}
+			if generate == nil {
+				t.Fatal("generate tool not discovered")
+			}
+			out, err := generate.Execute(ctx, map[string]any{"prompt": "red square", "request_id": "fixture-once"})
+			if err != nil {
+				t.Fatal(err)
+			}
+			const prefix = "__GBOT_TOOL_CONTENT__:"
+			if !strings.HasPrefix(out, prefix) {
+				t.Fatal("gbot did not preserve the MCP image envelope")
+			}
+			var env struct {
+				Content []sdk.ContentBlock `json:"content"`
+			}
+			if err := json.Unmarshal([]byte(strings.TrimPrefix(out, prefix)), &env); err != nil {
+				t.Fatal(err)
+			}
+			var task struct {
+				Status string `json:"status"`
+				Images []struct {
+					Path string `json:"path"`
+					URL  string `json:"url"`
+				} `json:"images"`
+			}
+			if err := json.Unmarshal([]byte(env.Content[0].Text), &task); err != nil {
+				t.Fatal(err)
+			}
+			if task.Status != "succeeded" || len(task.Images) != 1 {
+				t.Fatal("missing completed image task")
+			}
+			images := 0
+			previewURL := ""
+			for _, block := range env.Content {
+				if block.Type == "image_url" && block.ImageURL != nil {
+					images++
+					previewURL = block.ImageURL.URL
+					data, err := base64.StdEncoding.DecodeString(strings.TrimPrefix(block.ImageURL.URL, "data:image/png;base64,"))
+					if err != nil {
+						t.Fatal(err)
+					}
+					if _, err := png.Decode(bytes.NewReader(data)); err != nil {
+						t.Fatal(err)
+					}
+				}
+			}
+			if images != 1 {
+				t.Fatalf("got %d preview blocks, want 1", images)
+			}
+			if mode == "stdio" {
+				data, err := os.ReadFile(task.Images[0].Path)
+				if err != nil || !bytes.Equal(data, pngBytes.Bytes()) {
+					t.Fatal("original path invalid")
+				}
+			} else {
+				resp, err := http.Get(task.Images[0].URL)
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer resp.Body.Close()
+				if resp.StatusCode != http.StatusOK {
+					t.Fatal("original download failed")
+				}
+				if _, err := png.Decode(resp.Body); err != nil {
+					t.Fatal(err)
+				}
+			}
+			verifyImageReachesModel(t, ctx, tools, previewURL)
+			t.Log("five tools discovered; generation returned preview and original; agentloop forwarded image to the next model request")
+		})
+	}
+}
+
+func verifyImageReachesModel(t *testing.T, ctx context.Context, tools []sdk.Tool, previewURL string) {
+	t.Helper()
+	var calls atomic.Int32
+	var received atomic.Bool
+	modelServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var request struct {
+			Messages []struct {
+				Content json.RawMessage `json:"content"`
+			} `json:"messages"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&request); err != nil {
+			t.Error(err)
+			http.Error(w, "bad model request", http.StatusBadRequest)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		if calls.Add(1) == 1 {
+			_ = json.NewEncoder(w).Encode(map[string]any{"choices": []any{map[string]any{"message": map[string]any{
+				"role": "assistant", "content": "", "tool_calls": []any{map[string]any{
+					"id": "preview-call", "type": "function", "function": map[string]any{
+						"name": "mcp_image_gen_generate_image", "arguments": `{"prompt":"red square","request_id":"fixture-once"}`,
+					},
+				}},
+			}}}})
+			return
+		}
+		for _, message := range request.Messages {
+			var blocks []sdk.ContentBlock
+			if json.Unmarshal(message.Content, &blocks) != nil {
+				continue
+			}
+			for _, block := range blocks {
+				if block.Type == "image_url" && block.ImageURL != nil && block.ImageURL.URL == previewURL {
+					received.Store(true)
+				}
+			}
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{"choices": []any{map[string]any{"message": map[string]any{"role": "assistant", "content": "preview received"}}}})
+	}))
+	defer modelServer.Close()
+	registry := toolruntime.NewRegistry()
+	for _, tool := range tools {
+		registry.Register(tool)
+	}
+	settings := agentloop.DefaultSettings()
+	settings.MaxToolIterations = 3
+	loop := &agentloop.Loop{
+		Settings: settings, Workspace: t.TempDir(), Model: "vision-fixture", Tools: registry,
+		DisableContextFiles: true, DisableAutoCompact: true, HTTPClient: modelServer.Client(),
+		Providers: agentloop.StaticResolver{Spec: sdk.ProviderSpec{Name: "openai"}, APIKey: "fixture-key", APIBase: modelServer.URL + "/v1"},
+	}
+	result, err := loop.Run(ctx, "Generate a red square and inspect the preview")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Content != "preview received" || calls.Load() != 2 || !received.Load() {
+		t.Fatalf("image did not reach next model request: calls=%d image_received=%v", calls.Load(), received.Load())
+	}
+}
